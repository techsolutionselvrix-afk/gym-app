# ---- Environment ----
APP_ENV=development
APP_NAME=gym-backend
LOG_LEVEL=INFO

# ---- Supabase ----
# From Supabase dashboard: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...                  # safe to expose to mobile client
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # SERVER ONLY. NEVER ship to client.
SUPABASE_JWT_SECRET=super-long-secret     # Project Settings -> API -> JWT Settings

# ---- CORS ----
# Comma-separated allowed origins. Mobile app sends no Origin, so you only need web + dev.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ---- Admin bootstrap ----
# Email of the first super admin. On first run, backend will mark this profile as super_admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ---- Super admin seed (used by scripts/bootstrap_super_admin.py) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Super Admin
